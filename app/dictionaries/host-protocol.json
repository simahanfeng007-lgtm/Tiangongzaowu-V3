{
  "schema": "tiangong.dictionary.host-protocol.v1",
  "name": "omni_body",
  "description": "Tool / Skill 字典统一调用协议。简单动作可直接执行；复杂制作任务先用 skill.get 读取候选规程，再观察工具结果持续执行。只传 action/target/args；权限由宿主独立裁决。完整 JSON 参数通过校验后才会执行。",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "当前 Tool 字典中的动作 ID。能力发现用 system.capabilities，参数查询用 system.action_schema，Skill 规程用 skill.get。实际执行必须对应已发布字典绑定。",
        "minLength": 1
      },
      "target": {
        "type": "string",
        "description": "动作的主目标，例如工作区相对文件路径或 Skill ID；无目标的动作可省略。工作区和权限由系统绑定。"
      },
      "args": {
        "type": "object",
        "description": "动作专用参数，必须是 JSON 对象。写文件使用 args.content；运行现有脚本使用 target 和 args.argv。示例：{\"action\":\"file.write\",\"target\":\"out.txt\",\"args\":{\"content\":\"正文\"}}。只填写该动作需要的字段。",
        "properties": {
          "content": {
            "type": "string",
            "description": "file.write/code.write/file.append 的完整文本内容。"
          },
          "base64": {
            "type": "string",
            "description": "二进制文件的 base64 内容。"
          },
          "encoding": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "python.run 短检查的 Python 源码。"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "传给 target 脚本的参数。"
          },
          "timeout": {
            "type": "number"
          },
          "query": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "string"
          },
          "frame_rate": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "_task_profile": {
        "type": "object",
        "description": "可选的任务理解建议。轻量任务可省略；Runtime 会在工具执行前移除，并只把用户目标与真实证据作为验收权威。",
        "properties": {
          "schema": {
            "type": "string",
            "enum": [
              "tiangong.v3.task_profile.v2"
            ]
          },
          "proposed_level": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          },
          "desired_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "effect",
                    "execution",
                    "delivery"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "success_condition": {
                  "type": "string"
                }
              },
              "required": [
                "fact_id",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "plan_hint": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "step_id",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "constraints": {
            "type": "object",
            "properties": {
              "forbidden_tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "schema",
          "proposed_level"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "action",
      "args"
    ],
    "additionalProperties": false
  }
}
