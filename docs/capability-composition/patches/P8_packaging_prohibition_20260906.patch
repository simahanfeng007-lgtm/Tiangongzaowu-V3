index 0000000000000000000000000000000000000000..6ea2bccdbf28cdf9452b3cd48d2098c36cea94f2
--- /dev/null
+++ b/tests/test_p8_packaging_prohibition.py
@@ -0,0 +1,79 @@
+"""P8 real-task acceptance: a packaging prohibition is not a ZIP obligation."""
+from __future__ import annotations
+import pytest
+
+from v3.simple_chain.kernel import (
+    _has_delivery_intent, _requests_zip_delivery, _simple_chain_expected_suffixes,
+)
+
+@pytest.mark.parametrize('prohibition', [
+    '不要打包', '不用打包', '无需压缩', '无须压缩', '不必打包', '不需要打包',
+    '禁止打包', '不得打包', '不许生成压缩包', '不要生成ZIP文件',
+    '不要转成ZIP', '不用打包或生成压缩包', '不要打包、压缩或归档',
+    'do not zip', "don't package", 'without zipping', 'no ZIP files',
+    'do not create a ZIP archive', 'no need to zip',
+    '不要打包成ZIP', '不用压缩为ZIP文件', 'do not package as a ZIP archive',
+])
+def test_prohibition_does_not_add_format_or_delivery(prohibition):
+    request = f'请创建 proof.txt，内容为验收记录。{prohibition}。'
+    assert _simple_chain_expected_suffixes(request) == {'.txt'}
+    assert not _requests_zip_delivery(request)
+    assert not _has_delivery_intent(request)
+
+@pytest.mark.parametrize('prohibition', ['不要打包', '不用生成ZIP', 'do not zip'])
+def test_real_delivery_survives_but_does_not_require_zip(prohibition):
+    request = f'请生成 proof.txt 发给我，{prohibition}。'
+    assert _has_delivery_intent(request)
+    assert not _requests_zip_delivery(request)
+    assert _simple_chain_expected_suffixes(request) == {'.txt'}
+
+@pytest.mark.parametrize('user_text', [
+    '把 output/e2e 打包成 zip 发给我',
+    '请生成ZIP压缩包发给我',
+    '不要删除原文件，然后打包成 ZIP 发给我',
+    '不要忘记打包成zip发给我',
+    '不要只打包，请把压缩包发给我',
+    '不用打包第一份，第二份请打包成zip发给我',
+])
+def test_affirmative_packaging_is_not_globally_cancelled(user_text):
+    assert _requests_zip_delivery(user_text)
+    assert '.zip' in _simple_chain_expected_suffixes(user_text)
+
+def test_conversion_output_still_owns_format_after_prohibition():
+    request = '把 input.pdf 转成 Word 文档发给我，不用打包。'
+    assert _simple_chain_expected_suffixes(request) == {'.docx'}
+    assert _has_delivery_intent(request)
+    assert not _requests_zip_delivery(request)
+
+def test_model_reply_cannot_create_a_zip_obligation():
+    assert not _has_delivery_intent('请创建 proof.txt，不用打包。', '已打包成ZIP附件发送。')
+
+@pytest.mark.parametrize('literal', [
+    '"不要打包"', '`do not zip`', "'without zipping'", '“不用压缩”',
+    '「不需要打包」', '不要打包.zip', 'output/不要打包.zip',
+    r'D:\workspace\不要打包.zip',
+])
+def test_literal_or_filename_is_not_rewritten(literal):
+    from v3.simple_chain.kernel import _simple_chain_packaging_intent_surface
+    text = f'请保留原文或路径 {literal}。'
+    assert _simple_chain_packaging_intent_surface(text) == text
+
+
+def test_no_zip_request_does_not_make_missing_delivery_file_valid(tmp_path):
+    from v3.simple_chain.kernel import _simple_chain_paths_match_requested_formats
+    formats = _simple_chain_expected_suffixes('请创建 proof.txt 发给我，不要打包。')
+    assert formats == {'.txt'}
+    assert not _simple_chain_paths_match_requested_formats(
+        [str(tmp_path / 'missing.txt')], formats,
+    )
+
+
+def test_real_zip_request_still_rejects_plain_text_with_zip_extension(tmp_path):
+    from v3.simple_chain.kernel import _simple_chain_paths_match_requested_formats
+    request = '不要删除原文，请打包成ZIP发给我。'
+    assert _requests_zip_delivery(request)
+    path = tmp_path / 'fake.zip'
+    path.write_text('This is not a ZIP archive.', encoding='utf-8')
+    assert not _simple_chain_paths_match_requested_formats(
+        [str(path)], _simple_chain_expected_suffixes(request),
+    )
