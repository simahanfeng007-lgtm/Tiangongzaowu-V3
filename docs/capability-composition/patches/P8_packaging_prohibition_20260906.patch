+def _simple_chain_packaging_intent_surface(user_message: str) -> str:
+    """Exclude explicit packaging prohibitions without dropping other commands.
+
+    This narrow intent correction grants no permission and proves no completion.
+    Quoted literals and filenames remain unchanged; a later affirmative request
+    still applies. Other negation grammar is left to the existing intent path.
+    """
+    text = str(user_message or "")
+    package_atom = (
+        r"(?:zipping|zip(?:\s*(?:压缩包|文件|包|archives?|files?))?|"
+        r"压缩包|归档文件|打包|压缩|归档|packaging|package|archives?)"
+    )
+    package = (
+        package_atom
+        + r"(?:\s*(?:成|为|into\b|as\b)\s*(?:(?:a|an|the)\s+)?"
+        + package_atom + r")?"
+    )
+    operation = r"(?:(?:再|进行|生成|创建|制作|提供|输出|发送|交付|使用|做成|转换成|转成|转换为|转为|导出为|另存为)\s*)?"
+    prohibition = (
+        r"(?:不要|不得|不许|不用|无需|无须|不必|不需要|禁止|严禁|别)\s*" + operation
+        + r"|\b(?:do\s+not|don't|must\s+not|no\s+need\s+to|no|without|skip|avoid)\s+"
+        + r"(?:(?:create|make|generate|send|provide|use)\s+(?:(?:a|an|the)\s+)?)?"
+    )
+    pattern = re.compile(
+        r"(?:" + prohibition + r")" + package
+        + r"(?:\s*(?:、|和|或|以及|and\b|or\b)\s*" + operation + package + r")*",
+        re.IGNORECASE,
+    )
+    literals = re.compile(
+        r'''"[^"\n]*"|`[^`\n]*`|'[^'\n]*'|“[^”\n]*”|「[^」\n]*」'''
+        + r'''|[^\s，。；,;!?！？"'`]+\.[A-Za-z0-9]{1,8}(?![\w.])'''
+    )
+    spans = [match.span() for match in literals.finditer(text)]
+    return pattern.sub(
+        lambda match: match.group(0) if any(
+            start < match.end() and match.start() < end for start, end in spans
+        ) else " ",
+        text,
+    )
+
+
