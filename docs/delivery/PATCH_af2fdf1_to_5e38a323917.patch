+        planned_action_ids=(),
+        static_comparison_action_ids=(),
+        added_vs_static=(),
+        removed_vs_static=(),
+        source_manifest_sha256=None,
+        observation_sha256="0" * 64,
+    ).with_computed_sha256()
+
+
+def _live_cases_and_bindings():
+    live_cases = []
+    bindings = []
