+
+@pytest.fixture
+def execution(intake_factory, tmp_path):
+    """R1C3 registration (with an accepted attachment) plus execution powers."""
+    objects = ContentAddressedObjectStore.open(
+        tmp_path / 'execution-objects', now_ms=900)
