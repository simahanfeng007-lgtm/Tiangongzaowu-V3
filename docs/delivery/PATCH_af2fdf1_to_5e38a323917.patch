+
+
+def _failed_dynamic(
+    value: P11DynamicPathObservationV1,
+    *,
+    error_code: str = "proposal.json.invalid",
+) -> P11DynamicPathObservationV1:
+    return replace(
+        value,
+        parse_succeeded=False,
+        repair_attempted=False,
